# Copy this file to .env and put your real key after the = sign (no quotes, no spaces).
# .env is listed in .gitignore, so it never goes to GitHub.
  OPENAI_API_KEY=sk-your-key-here
# Optional. Pick the cheapest current small model on https://openai.com/api/pricing
# and copy its name and prices (USD per 1 million tokens) here. Prices only feed the
# cost estimate; your OpenAI usage page shows the real spend.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PRICE_INPUT_PER_M=0.40
OPENAI_PRICE_CACHED_INPUT_PER_M=0.10
OPENAI_PRICE_OUTPUT_PER_M=1.60
